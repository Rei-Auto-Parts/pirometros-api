# Copie para `.env` (ignorado pelo git) e ajuste. Nunca versione segredos.

# Banco `pirometros` do Postgres. Em producao (Easypanel) o host interno e banco_dados_postgres.
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@banco_dados_postgres:5432/pirometros

# Porta HTTP da API.
PORT=8000

# DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=INFO

# Aplica as migrations do schema `app` ao subir (idempotente).
RUN_MIGRATIONS_ON_START=true
